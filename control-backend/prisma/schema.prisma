generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =========================
// 👤 ROLES DEL SISTEMA
// =========================
enum Role {
  USER
  ADMIN
}

// =========================
// 💰 TIPO DE TRANSACCIÓN
// =========================
enum TransactionType {
  INCOME   // dinero que entra
  EXPENSE  // dinero que sale
}

// =========================
// 💳 MÉTODO DE PAGO
// =========================
enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  YAPE
  PLIN
}

// =========================
// 📊 ESTADO FINANCIERO
// =========================
enum TransactionStatus {
  PENDING   // por cobrar / por pagar
  PAID      // pagado / cobrado
  PARTIAL   // pago parcial
  CANCELLED // anulado
}
// Monedas
enum Currency {
  PEN
  USD
}
// =========================
// 👤 USUARIO
// =========================
model User {
  id        String   @id @default(uuid())
  name      String
  lastName  String
  email     String   @unique
  password  String
  role      Role @default(USER)
  currency  String   @default("PEN")
  isActive  Boolean  @default(true)

  resetToken       String?
  resetTokenExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories   Category[]
  transactions Transaction[]
}

// =========================
// 📂 CATEGORÍAS
// =========================
model Category {
  id     String @id @default(uuid())
  name   String
  type   TransactionType
  color  String?

  userId String
  user   User @relation(fields: [userId], references: [id])

  // árbol categoría / subcategoría
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  transactions    Transaction[] @relation("CategoryTransaction")
  subTransactions Transaction[] @relation("SubCategoryTransaction")

  createdAt DateTime @default(now())
}

// =========================
// 💰 TRANSACCIONES (NÚCLEO DEL SISTEMA)
// =========================
model Transaction {

  // 🔑 ID
  id String @id @default(uuid())

  // 📌 INGRESO / EGRESO
  type TransactionType

  // 📊 ESTADO (CLAVE PARA TUS 4 MÓDULOS)
  status TransactionStatus @default(PENDING)

  // 👤 USUARIO
  userId String
  user   User @relation(fields: [userId], references: [id])

  // 🟢 CATEGORÍA
  categoryId String
  category   Category @relation("CategoryTransaction", fields: [categoryId], references: [id])

  // 🟣 SUBCATEGORÍA
  subCategoryId String?
  subCategory   Category? @relation("SubCategoryTransaction", fields: [subCategoryId], references: [id])

  // 📅 FECHA PRINCIPAL
  date DateTime

  // 📅 FECHA DE VENCIMIENTO (CUENTAS PENDIENTES)
  dueDate DateTime?

  // 💳 MÉTODO DE PAGO
  paymentMethod PaymentMethod

  // 📝 DESCRIPCIÓN
  description String?

  // 💰 MONTO
  amount Float

  // 💱 MONEDA
  currency Currency

  // 💵 TIPO DE CAMBIO
  exchangeRate Float?

  // 🇵🇪 MONTO EN SOLES
  amountSoles Float?

  programmed Boolean @default(false)
  justified Boolean @default(false)

  // ⏱ CONTROL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}