generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================================================
// 🏢 1. IDENTIDAD, MULTI-EMPRESA & ROLES (RBAC)
// =======================================================
enum Role {
  SUPERADMIN
  ADMIN
  MANAGER
  CASHIER
  SELLER
  WAREHOUSE_KEEPER
  ACCOUNTANT
  USER
}

enum Currency {
  PEN
  USD
  EUR
}

enum WorkspaceType {
  PERSONAL
  BUSINESS
}

model User {
  id              String   @id @default(uuid())
  name            String
  lastName        String
  email           String   @unique
  password        String
  role            Role     @default(USER)
  currency        String   @default("PEN")
  isActive        Boolean  @default(true)
  profiles        Json?
  blockedProfiles Json?

  parentId String?

  personalAvatar       String?
  businessName         String?
  businessRuc          String?
  businessReason       String?
  businessRubro        String?
  businessLogo         String?
  businessBanner       String?
  businessSlug         String?   @unique
  businessAddress      String?
  businessPhone        String?
  businessEmail        String?
  businessDepartment   String?
  businessProvince     String?
  businessDistrict     String?
  billingSerieInvoice  String?   @default("F001")
  billingSerieBoleta   String?   @default("B001")
  catalogConfig        Json?
  hasElectronicBilling Boolean @default(false)
  nubefactUrl          String?
  nubefactToken        String?
  taxRegime            String?   @default("GENERAL_18")
  igvRate              Float?    @default(18.0)

  resetToken       String?
  resetTokenExpiry DateTime?
  cashRegisterPin  String?

  isSelfRegistered Boolean   @default(false)
  trialEndsAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  categories         Category[]
  transactions       Transaction[]
  notifications      Notification[]
  products           Product[]
  cashShifts         CashShift[]
  purchaseOrders     PurchaseOrder[]
  inventoryMovements InventoryMovement[]

  branchId               String?
  branch                 Branch?           @relation("BranchWorkers", fields: [branchId], references: [id], onDelete: SetNull)
  branches               Branch[]          @relation("OwnerBranches")
  brands                 Brand[]
  families               Family[]
  sales                  Sale[]
  advisorLabel           String            @default("Asesor de venta")
  agentRoleSingular      String            @default("Asesor de venta")
  agentRolePlural        String            @default("Asesores")
  defaultCommissionModel String            @default("PERCENTAGE")
  advisors               Advisor[]         @relation("UserAdvisors")
  commissionModels       CommissionModel[]

  // Nuevas relaciones empresariales
  warehouses            Warehouse[]
  treasuryAccounts      TreasuryAccount[]
  treasuryTransactions  TreasuryTransaction[]
  customers             Customer[]
  suppliers             Supplier[]
  cashRegisters         CashRegister[]
  productionOrders      ProductionOrder[]
  fiscalDocuments       FiscalDocument[]
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  description String
  link        String
  read        Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// =======================================================
// 🏢 2. SUCURSALES, ALMACENES & UBICACIONES (WMS)
// =======================================================
model Branch {
  id        String   @id @default(uuid())
  name      String
  code      String?
  address   String?
  phone     String?
  department   String?
  province     String?
  district     String?
  taxRegime    String?   // override if set: "GENERAL_18", "AMAZONIA_EXONERADO", "RESTAURANTES_10", etc.
  igvRate      Float?
  userId    String
  user      User     @relation("OwnerBranches", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks       BranchStock[]
  cashShifts   CashShift[]
  workers      User[]                @relation("BranchWorkers")
  transactions Transaction[]
  movements    InventoryMovement[]
  sales        Sale[]
  warehouses   Warehouse[]
  cashRegisters CashRegister[]
  fiscalDocuments FiscalDocument[]
}

model Warehouse {
  id          String   @id @default(uuid())
  name        String   // "Almacén Principal", "Almacén En Tránsito", "Almacén Merma"
  code        String?
  isDefault   Boolean  @default(false)
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  stocks      WarehouseStock[]
  movementsFrom InventoryMovement[] @relation("OriginWarehouse")
  movementsTo   InventoryMovement[] @relation("DestinationWarehouse")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WarehouseStock {
  id          String   @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stock       Float    @default(0)
  reservedStock Float  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, productId, variantId])
}

// Compatibilidad con schema legacy
model BranchStock {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stock     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, branchId])
}

// =======================================================
// 📦 3. CATÁLOGO MAESTRO MULTI-RUBRO & VARIANTES
// =======================================================
enum ProductType {
  SIMPLE          // Estándar
  VARIABLE        // Talla / Color / Series
  SERVICE         // No almacenable
  COMBO           // Kit / Pack
  MANUFACTURED    // Con orden de producción (BOM)
}

enum TrackingType {
  STANDARD        // Control por cantidad entera o decimal
  SERIALIZED      // Unitaria por Serie / IMEI / Código de Par
  BATCH_EXPIRY    // Lote y Fecha de Vencimiento (Farmacia/Alimentos)
  FRACTIONAL      // Peso balanza / Granel
}

model Category {
  id        String          @id @default(uuid())
  name      String
  type      TransactionType
  color     String?

  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentId  String?
  parent    Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]      @relation("CategoryTree")

  transactions    Transaction[] @relation("CategoryTransaction")
  subTransactions Transaction[] @relation("SubCategoryTransaction")
  products        Product[]

  createdAt DateTime @default(now())
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Family {
  id        String    @id @default(uuid())
  name      String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id            String       @id @default(uuid())
  name          String
  description   String?      @db.Text
  sku           String?
  barcode       String?
  customCode    Int          @default(0)
  color         String?
  costPrice     Float        @default(0)
  salePrice     Float        @default(0)
  adjustedPrice Float?
  wholesalePrice Float?
  distributorPrice Float?
  initialStock  Float        @default(0)
  stock         Float        @default(0)
  minStock      Float        @default(5)
  maxStock      Float?
  unit          String       @default("UNIDAD")
  imageUrl      String?

  productType   ProductType  @default(SIMPLE)
  trackingType  TrackingType @default(STANDARD)

  // Datos fiscales
  sunatCode     String?      // Código SUNAT / GS1
  taxCode       String       @default("10") // 10=Gravado IGV, 20=Exonerado, 30=Inafecto
  hasIgv        Boolean      @default(true)

  // Rubro farmacia / medicina
  activeSubstance String?    // Principio activo
  laboratory      String?
  requiresPrescription Boolean @default(false)

  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId       String?
  brand         Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  familyId      String?
  family        Family?      @relation(fields: [familyId], references: [id], onDelete: SetNull)

  // Relaciones
  presentations      Presentation[]
  movements          InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  branchStocks       BranchStock[]
  warehouseStocks    WarehouseStock[]
  saleItems          SaleItem[]

  // Variantes N-dimensionales (Talla, Color, Serie)
  variants           ProductVariant[]
  batches            ProductBatch[]
  serials            VariantSerial[]
  seriesCurves       SeriesCurve[]

  priceWithAgent     Float?
  commissionType     String       @default("PERCENT")
  commissionValue    Float        @default(0.0)

  // Manufactura (BOM)
  bom                BillOfMaterials?
  bomItems           BomItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Variantes hijas de un producto (ej: Zapatilla Nike Talla 40 Color Negro)
model ProductVariant {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku         String?  @unique
  barcode     String?  @unique
  name        String   // "Talla 40 / Negro"
  size        String?  // "40", "L", "10.5"
  color       String?  // "Negro", "Azul"
  material    String?  // "Cuero", "Sintético"
  extraAttrs  Json?    // Atributos dinámicos adicionales en JSONB

  costPrice   Float    @default(0)
  salePrice   Float    @default(0)
  initialStock Float    @default(0)
  stock       Float    @default(0)

  warehouseStocks WarehouseStock[]
  serials         VariantSerial[]
  saleItems       SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Números de serie individuales (para calzado por serie, celulares IMEI, maquinaria)
model VariantSerial {
  id          String    @id @default(uuid())
  serialNumber String   // "IMEI123456789", "SERIE-ZAP-0091"
  status      String    @default("AVAILABLE") // AVAILABLE, SOLD, RESERVED, DEFECTIVE

  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  soldAt      DateTime?
  saleItemId  String?
  saleItem    SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([productId, serialNumber])
}

// Curvas de Calzado / Bultos Cerrados (Caja x 12 pares con surtido de tallas)
model SeriesCurve {
  id          String   @id @default(uuid())
  name        String   // "Curva 38-42 (1-2-4-3-2)"
  boxCode     String?  // Código de barras del bulto
  pairsTotal  Int      @default(12)
  curveDetail Json     // [{"size": "38", "qty": 1}, {"size": "39", "qty": 2}, ...]
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  pricePerBox Float    @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Lotes con fecha de caducidad (Farmacia, Alimentos, Químicos)
model ProductBatch {
  id              String   @id @default(uuid())
  batchNumber     String   // "LOT-2026-X9"
  expiryDate      DateTime
  manufacturingDate DateTime?
  initialStock    Float    @default(0)
  currentStock    Float    @default(0)
  costPrice       Float    @default(0)

  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, batchNumber])
}

// Presentaciones y Unidades de Medida
model Presentation {
  id          String   @id @default(uuid())
  name        String   // "Saco 50kg", "Caja x 24", "Kilo", "Blister"
  equivalence Float    // Factor de conversión a unidad base
  price       Float

  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  movements   InventoryMovement[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Movimientos de Kardex Formal
enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

model InventoryMovement {
  id        String       @id @default(uuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Float
  type      MovementType
  reason    String?      // "SALE", "PURCHASE", "TRANSFER", "DAMAGE", "INITIAL"

  presentationId   String?
  presentation     Presentation? @relation(fields: [presentationId], references: [id], onDelete: Restrict)
  presentationName String?
  presentationQty  Float?

  // Kardex fields
  unitCost    Float   @default(0)
  totalCost   Float   @default(0)
  stockResult Float   @default(0)
  documentId  String?

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  originWarehouseId String?
  originWarehouse   Warehouse? @relation("OriginWarehouse", fields: [originWarehouseId], references: [id], onDelete: SetNull)
  destinationWarehouseId String?
  destinationWarehouse   Warehouse? @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// =======================================================
// 💰 4. TESORERÍA CENTRAL VS CAJAS OPERATIVAS (POS)
// =======================================================
enum TreasuryAccountType {
  BANK_ACCOUNT    // Cuentas BCP, BBVA, Interbank
  CENTRAL_VAULT   // Bóveda / Caja Fuerte Central
  DIGITAL_WALLET  // Yape Empresa / Plin Empresa
}

model TreasuryAccount {
  id          String              @id @default(uuid())
  name        String              // "BCP Soles Operaciones", "Bóveda Central"
  accountType TreasuryAccountType @default(BANK_ACCOUNT)
  bankName    String?             // "BCP", "BBVA", "Scotiabank"
  accountNumber String?
  cciNumber   String?
  currency    Currency            @default(PEN)
  balance     Float               @default(0)
  isDefault   Boolean             @default(false)

  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions TreasuryTransaction[]
  purchaseOrders PurchaseOrder[]

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

enum TreasuryMovementType {
  DEPOSIT           // Depósito / Inyección de capital
  WITHDRAWAL        // Retiro
  TRANSFER_IN       // Entrada por transferencia interna
  TRANSFER_OUT      // Salida por transferencia interna
  PURCHASE_PAYMENT  // Pago a proveedor por compra
  SHIFT_REMITTANCE  // Remesa diaria de caja de ventas
  EXPENSE_PAYMENT   // Gasto operativo / Alquiler / Servicios
  COMMISSION_PAYOUT // Pago de comisiones a asesores
}

model TreasuryTransaction {
  id                String               @id @default(uuid())
  treasuryAccountId String
  treasuryAccount   TreasuryAccount      @relation(fields: [treasuryAccountId], references: [id], onDelete: Cascade)
  type              TreasuryMovementType
  amount            Float
  currency          Currency             @default(PEN)
  referenceNumber   String?              // Número de operación bancaria
  description       String
  receiptUrl        String?
  relatedShiftId    String?              // Si proviene de un arqueo de caja POS
  purchaseOrderId   String?              // Si proviene de una compra

  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime             @default(now())
}

// Cajas Físicas de Mostrador (Terminales POS)
model CashRegister {
  id        String      @id @default(uuid())
  name      String      // "Caja Mostrador 1", "Caja Pasadizo"
  code      String?
  branchId  String
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  shifts    CashShift[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model CashShift {
  id             String      @id @default(uuid())
  openedAt       DateTime    @default(now())
  closedAt       DateTime?
  initialBalance Float       @default(0)
  finalBalance   Float?      // Lo que contó físicamente el cajero
  expectedBalance Float?     // Lo que el sistema calculó
  difference     Float?      // Sobrante o Faltante
  totalSales     Float       @default(0)
  status         ShiftStatus @default(OPEN)
  notes          String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)

  transactions Transaction[] @relation("CashShiftTransactions")
  sales        Sale[]        @relation("CashShiftSales")
  movements    CashMovement[]
}

// Movimientos de Caja Chica durante el turno (ej. compra menor de café/limpieza)
enum CashMovementType {
  INCOME_PETTY
  EXPENSE_PETTY
}

model CashMovement {
  id          String           @id @default(uuid())
  cashShiftId String
  cashShift   CashShift        @relation(fields: [cashShiftId], references: [id], onDelete: Cascade)
  type        CashMovementType
  amount      Float
  reason      String           // "Compra de bolsas", "Cambio sencillo"
  receiptUrl  String?

  createdAt   DateTime         @default(now())
}

// =======================================================
// 🛍️ 5. VENTAS, CLIENTES & POS
// =======================================================
enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  YAPE
  PLIN
  CREDIT
  MIXED
}

enum TransactionStatus {
  PENDING
  PAID
  PARTIAL
  CANCELLED
}

model Customer {
  id             String   @id @default(uuid())
  name           String   // Razón Social o Nombre
  documentType   String   @default("DNI") // DNI, RUC, CE, PASAPORTE
  documentNumber String
  address        String?
  phone          String?
  email          String?
  creditLimit    Float    @default(0)
  creditDays     Int      @default(0)
  currentDebt    Float    @default(0)

  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  sales          Sale[]
  receivables    AccountsReceivable[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, documentNumber])
}

model Sale {
  id        String   @id @default(uuid())
  code      String?  // Código visible de venta

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  workspace String   @default("PERSONAL")

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  date        DateTime   @default(now())
  cashShiftId String?
  cashShift   CashShift? @relation("CashShiftSales", fields: [cashShiftId], references: [id], onDelete: SetNull)

  paymentMethod PaymentMethod
  amount        Float
  currency      Currency      @default(PEN)
  exchangeRate  Float?
  amountSoles   Float?

  advisorId String?
  advisor   Advisor? @relation(fields: [advisorId], references: [id], onDelete: SetNull)

  // Facturación Electrónica local
  billingType          String
  billingStatus        String?
  billingNumber        Int?
  billingSerie         String?
  billingError         String? @db.Text
  billingPdfUrl        String? @db.Text
  billingXmlUrl        String? @db.Text
  billingCdrUrl        String? @db.Text
  clientDocumentType   String?
  clientDocumentNumber String?
  clientDenomination   String?
  clientAddress        String?
  clientEmail          String?
  taxRegime            String?   @default("GENERAL_18")
  igvRate              Float?    @default(18.0)
  totalGravada         Float?    @default(0)
  totalExonerada       Float?    @default(0)
  totalInafecta        Float?    @default(0)
  totalIgv             Float?    @default(0)

  items       SaleItem[]
  commissions Commission[]
  payments    SalePayment[]
  fiscalDocument FiscalDocument?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SaleItem {
  id               String   @id @default(uuid())
  saleId           String
  sale             Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name             String
  quantity         Float
  price            Float
  commissionType   String?
  commissionValue  Float?
  commissionAmount Float?

  serials          VariantSerial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Multi-Pago por Venta (ej. 50 efectivo + 100 tarjeta)
model SalePayment {
  id            String        @id @default(uuid())
  saleId        String
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod
  amount        Float
  reference     String?       // Número de voucher o transacción

  createdAt     DateTime      @default(now())
}

// Cuentas por Cobrar a Clientes
model AccountsReceivable {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  saleId      String?
  totalAmount Float
  paidAmount  Float    @default(0)
  balance     Float
  dueDate     DateTime
  status      TransactionStatus @default(PENDING)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Modelo transaccional legacy conservado para total compatibilidad
model Transaction {
  id String @id @default(uuid())

  type TransactionType
  status TransactionStatus @default(PENDING)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation("CategoryTransaction", fields: [categoryId], references: [id], onDelete: Cascade)

  subCategoryId String?
  subCategory   Category? @relation("SubCategoryTransaction", fields: [subCategoryId], references: [id], onDelete: SetNull)

  date DateTime
  dueDate DateTime?
  paidAt DateTime?

  paymentMethod PaymentMethod
  name String?
  description String?
  amount   Float
  currency Currency
  exchangeRate Float?
  amountSoles Float?

  programmed Boolean @default(false)
  justified  Boolean @default(false)
  receiptUrl String?
  workspace String @default("PERSONAL")

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  isPosSale   Boolean    @default(false)
  cashShiftId String?
  cashShift   CashShift? @relation("CashShiftTransactions", fields: [cashShiftId], references: [id], onDelete: SetNull)

  originAccount      String?
  destinationAccount String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================================================
// 🚚 6. COMPRAS, PROVEEDORES & CUENTAS POR PAGAR
// =======================================================
model Supplier {
  id             String   @id @default(uuid())
  businessName   String
  documentType   String   @default("RUC")
  documentNumber String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  creditDays     Int      @default(0)

  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  purchaseOrders PurchaseOrder[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, documentNumber])
}

enum PurchaseOrderStatus {
  PENDING   // Creado, sin pagar
  APPROVED  // Aprobado por compras
  PAID      // Pagado desde Tesorería
  RECEIVED  // Ingresado al almacén
  CANCELLED // Cancelado
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  code          String?
  totalCost     Float
  status        PurchaseOrderStatus @default(PENDING)
  paymentMethod PaymentMethod
  categoryId    String
  subCategoryId String?
  receiptUrl    String?
  wasPaid       Boolean             @default(false)

  supplierId    String?
  supplier      Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  treasuryAccountId String?
  treasuryAccount   TreasuryAccount? @relation(fields: [treasuryAccountId], references: [id], onDelete: SetNull)

  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         PurchaseOrderItem[]

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity         Float
  equivalence      Float         @default(1.0)
  presentationId   String?
  presentationName String?
  costPrice        Float
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// =======================================================
// 🧾 7. SUBSISTEMA DE FACTURACIÓN ELECTRÓNICA DESACOPLADO
// =======================================================
enum FiscalDocType {
  INVOICE          // Factura Electrónica
  BOLETA           // Boleta de Venta Electrónica
  CREDIT_NOTE      // Nota de Crédito
  DEBIT_NOTE       // Nota de Débito
  DISPATCH_GUIDE   // Guía de Remisión Electrónica
}

enum FiscalStatus {
  LOCAL_DRAFT       // Emitido internamente
  QUEUED_OUTBOX     // En cola para el software facturador
  PROCESSING        // Siendo firmado / enviado a SUNAT
  ACCEPTED          // Aceptado con CDR
  REJECTED          // Rechazado con código de error
  CANCELLED         // Anulado / Comunicado de baja
}

model FiscalDocument {
  id              String        @id @default(uuid())
  docType         FiscalDocType
  serie           String        // "F001", "B001", "T001"
  correlative     Int           // 1, 2, 3...
  fullNumber      String        // "F001-00000123"

  status          FiscalStatus  @default(LOCAL_DRAFT)

  // Datos del Emisor y Receptor
  issuerRuc       String
  customerDocType String        // "6" (RUC), "1" (DNI)
  customerDocNum  String
  customerName    String
  customerAddress String?

  // Importes
  totalOpGravada  Float         @default(0)
  totalOpInafecta Float         @default(0)
  totalOpExonerada Float        @default(0)
  totalIgv        Float         @default(0)
  totalAmount     Float         @default(0)
  currency        Currency      @default(PEN)

  // Archivos generados por el Facturador
  hash            String?
  xmlUrl          String?       @db.Text
  pdfUrl          String?       @db.Text
  cdrUrl          String?       @db.Text
  sunatResponseCode String?
  sunatDescription  String?     @db.Text

  saleId          String?       @unique
  sale            Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)

  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  outboxEvents    FiscalOutbox[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([userId, docType, serie, correlative])
}

// Cola de Despacho Asíncrona (Transactional Outbox Pattern)
enum OutboxStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model FiscalOutbox {
  id               String         @id @default(uuid())
  fiscalDocumentId String
  fiscalDocument   FiscalDocument @relation(fields: [fiscalDocumentId], references: [id], onDelete: Cascade)

  eventType        String         // "EMIT_CPE", "CANCEL_CPE", "SEND_EMAIL"
  payload          Json           // Estructura canónica lista para UBL 2.1
  attempts         Int            @default(0)
  maxAttempts      Int            @default(5)
  status           OutboxStatus   @default(PENDING)
  lastError        String?        @db.Text
  nextAttemptAt    DateTime       @default(now())

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// =======================================================
// ⚙️ 8. MANUFACTURA & RECETAS (MRP BÁSICO / GASTRO)
// =======================================================
model BillOfMaterials {
  id          String    @id @default(uuid())
  name        String    // "Receta Pizza Familiar" o "Ensamble Zapato Cuero 40"
  productId   String    @unique
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  laborCost   Float     @default(0)
  overheadCost Float    @default(0)

  items       BomItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BomItem {
  id        String          @id @default(uuid())
  bomId     String
  bom       BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  productId String          // Insumo o materia prima
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Float           // Cantidad consumida
  unit      String          @default("UNIDAD")

  createdAt DateTime        @default(now())
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ProductionOrder {
  id          String           @id @default(uuid())
  code        String
  productId   String
  quantity    Float            // Cantidad a fabricar
  status      ProductionStatus @default(PLANNED)
  totalCost   Float            @default(0)

  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// =======================================================
// 🤝 9. ASESORES, COMISIONES & CRM
// =======================================================
model Advisor {
  id                   String  @id @default(uuid())
  name                 String
  commissionPercentage Float   @default(0.0)
  commissionType       String  @default("PERCENT")
  commissionValue      Float   @default(0.0)
  isActive             Boolean @default(true)
  userId               String
  user                 User    @relation("UserAdvisors", fields: [userId], references: [id], onDelete: Cascade)

  commissionModelId String?
  commissionModel   CommissionModel? @relation(fields: [commissionModelId], references: [id], onDelete: SetNull)

  sales       Sale[]
  commissions Commission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model CommissionModel {
  id    String @id @default(uuid())
  name  String
  type  String
  value Float  @default(0.0)

  applyTo         String  @default("SALE")
  minCommission   Float   @default(0.0)
  maxCommission   Float?
  allowDiscounts  Boolean @default(true)
  allowManualEdit Boolean @default(true)
  isAdditional    Boolean @default(false)

  categoryIds Json?
  brandIds    Json?
  productIds  Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  advisors Advisor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

model Commission {
  id        String  @id @default(uuid())
  advisorId String
  advisor   Advisor @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  amount        Float
  status        CommissionStatus @default(PENDING)
  isAdditional  Boolean          @default(false)
  transactionId String?          @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  SCHEDULED
  WON
  LOST
}

model Lead {
  id                 String     @id @default(uuid())
  name               String
  phone              String
  email              String?
  businessName       String?
  businessType       String?
  interestType       String     @default("DEMO")
  status             LeadStatus @default(NEW)
  appointmentDate    String?
  appointmentTime    String?
  notes              String?    @db.Text
  monthlySalesVolume String?
  utmSource          String?
  utmCampaign        String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

// =======================================================
// 🛡️ 10. BITÁCORA FORENSE DE AUDITORÍA
// =======================================================
model AuditLog {
  id        String   @id @default(uuid())
  action    String   // "INSERT", "UPDATE", "DELETE", "FORCE_OVERRIDE"
  tableName String
  recordId  String
  oldValues Json?
  newValues Json?
  ipAddress String?
  userId    String?
  userEmail String?
  createdAt DateTime @default(now())
}
