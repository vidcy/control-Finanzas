generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =========================
// 👤 ROLES DEL SISTEMA
// =========================
enum Role {
  USER
  ADMIN
}

// =========================
// 💰 TIPO DE TRANSACCIÓN
// =========================
enum TransactionType {
  INCOME   // dinero que entra
  EXPENSE  // dinero que sale
}

// =========================
// 💳 MÉTODO DE PAGO
// =========================
enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  YAPE
  PLIN
}

// =========================
// 📊 ESTADO FINANCIERO
// =========================
enum TransactionStatus {
  PENDING   // por cobrar / por pagar
  PAID      // pagado / cobrado
  PARTIAL   // pago parcial
  CANCELLED // anulado
}
// Monedas
enum Currency {
  PEN
  USD
}
// =========================
// 👤 USUARIO
// =========================
model User {
  id        String   @id @default(uuid())
  name      String
  lastName  String
  email     String   @unique
  password  String
  role      Role @default(USER)
  currency  String   @default("PEN")
  isActive  Boolean  @default(true)
  profiles  Json?

  resetToken       String?
  resetTokenExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories   Category[]
  transactions Transaction[]
  notifications Notification[]
  products     Product[]
  cashShifts   CashShift[]
}

// =========================
// 🔔 NOTIFICACIONES
// =========================
model Notification {
  id          String   @id @default(uuid())
  title       String
  description String
  link        String
  read        Boolean  @default(false)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  createdAt   DateTime @default(now())
}

// =========================
// 📂 CATEGORÍAS
// =========================
model Category {
  id     String @id @default(uuid())
  name   String
  type   TransactionType
  color  String?

  userId String
  user   User @relation(fields: [userId], references: [id])

  // árbol categoría / subcategoría
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  transactions    Transaction[] @relation("CategoryTransaction")
  subTransactions Transaction[] @relation("SubCategoryTransaction")

  createdAt DateTime @default(now())
}

// =========================
// 💰 TRANSACCIONES (NÚCLEO DEL SISTEMA)
// =========================
model Transaction {

  // 🔑 ID
  id String @id @default(uuid())

  // 📌 INGRESO / EGRESO
  type TransactionType

  // 📊 ESTADO (CLAVE PARA TUS 4 MÓDULOS)
  status TransactionStatus @default(PENDING)

  // 👤 USUARIO
  userId String
  user   User @relation(fields: [userId], references: [id])

  // 🟢 CATEGORÍA
  categoryId String
  category   Category @relation("CategoryTransaction", fields: [categoryId], references: [id])

  // 🟣 SUBCATEGORÍA
  subCategoryId String?
  subCategory   Category? @relation("SubCategoryTransaction", fields: [subCategoryId], references: [id])

  // 📅 FECHA PRINCIPAL
  date DateTime

  // 📅 FECHA DE VENCIMIENTO (CUENTAS PENDIENTES)
  dueDate DateTime?

  paidAt DateTime?

  // 💳 MÉTODO DE PAGO
  paymentMethod PaymentMethod

  // 📝 NOMBRE (PERSONA/DEUDOR/ACREEDOR)
  name String?

  // 📝 DESCRIPCIÓN
  description String?

  // 💰 MONTO
  amount Float

  // 💱 MONEDA
  currency Currency

  // 💵 TIPO DE CAMBIO
  exchangeRate Float?

  // 🇵🇪 MONTO EN SOLES
  amountSoles Float?

  programmed Boolean @default(false)
  justified Boolean @default(false)

  // 📎 COMPROBANTE/VOUCHER (URL de la imagen/pdf)
  receiptUrl String?

  // 🏢 ESPACIO DE TRABAJO (PERSONAL o BUSINESS)
  workspace String @default("PERSONAL")

  // ⏱ CONTROL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================
// 📦 PRODUCTOS (INVENTARIO SIMPLE)
// =========================
model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  sku         String?
  costPrice   Float    // Precio de compra/costo
  salePrice   Float    // Precio de venta
  stock       Int      @default(0)
  minStock    Int      @default(5)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// =========================
// 🗄️ CIERRE DE CAJA (CASH SHIFT)
// =========================
enum ShiftStatus {
  OPEN
  CLOSED
}

model CashShift {
  id              String      @id @default(uuid())
  openedAt        DateTime    @default(now())
  closedAt        DateTime?
  initialBalance  Float       @default(0)
  finalBalance    Float?
  totalSales      Float       @default(0)
  status          ShiftStatus @default(OPEN)

  userId          String
  user            User        @relation(fields: [userId], references: [id])
}